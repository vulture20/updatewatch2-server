<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <!-- Same gap the agent repo's csproj already fixed (previously unset,
         so the compiled binary's Company/Product/Copyright/File version
         were all blank/default) — see that repo's UpdateWatch2.Agent.csproj
         for the fuller explanation. Matches the copyright line already
         used in README.md. -->
    <Authors>Thorsten Schröpel</Authors>
    <Company>Thorsten Schröpel</Company>
    <Product>UpdateWatch2 Server</Product>
    <Copyright>Copyright (C) 2026 Thorsten Schröpel</Copyright>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../VERSION').Trim())</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Resources\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Baked into the assembly itself (loaded via
         Assembly.GetManifestResourceStream in EmailNotificationService)
         rather than copied as a loose file — guarantees it's present
         regardless of the container's working directory/content root,
         the same class of gap Certs:Path/AgentUpdates:Path already
         document elsewhere for path-relative config. -->
    <EmbeddedResource Include="Resources\Email\logo.png" />
  </ItemGroup>

</Project>
