{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Path": "../../data/updatewatch2.sqlite"
  },

  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "https://localhost:5173"]
  },

  "BruteForce": {
    "MaxAttempts": 6,
    "WindowMinutes": 5,
    "LockoutMinutes": 30
  },

  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "Encryption": "StartTls",
    "FromAddress": "",
    "FromName": "UpdateWatch2"
  },

  "NotificationThresholds": {
    "UpdatesPerMachine": 5,
    "AffectedMachines": 10
  },

  "Ad": {
    "Enabled": false,
    "Host": "",
    "Port": 389,
    "Encryption": "StartTls",
    "BindDn": "",
    "BindPassword": "",
    "BaseDn": "",
    "UserSearchFilter": "(&(objectClass=user)(sAMAccountName={0}))",
    "LoginGroupDn": ""
  }
}
