# UpdateWatch2 Server — example environment variables
# Copy to .env for local use. Do not commit real values.

UPDATEWATCH2_LOGLEVEL=INFO
UPDATEWATCH2_TRUSTEDIP=

# The externally-reachable hostname this server is addressed by — becomes
# the SAN on the agent-facing (port 8796) TLS certificate generated on
# first run. MUST match the ServerAddress agents are configured to dial:
# an agent pins and validates this certificate's SAN, not just that it
# chains to the server's internal CA, so a mismatch here means every
# agent connection fails certificate validation. Defaults to the
# container's own hostname if unset, which is almost never correct for a
# real deployment — see updatewatch2-server#1.
UPDATEWATCH2_SERVER_HOSTNAME=

# Set to "true" to seed a handful of realistic-looking dummy agents and
# their pending updates on startup, for demos on an otherwise-empty
# instance. Idempotent — safe to leave set across restarts, won't
# duplicate the seeded rows. Deliberately env-var-only, no admin-UI
# toggle. Never set this on a real production instance.
UPDATEWATCH2_DEMOMODE=

# Set to "false" to completely disable checking GitHub for new agent
# releases and distributing them to agents (updatewatch2-server#14) —
# overrides the admin-UI toggle outright, the same env-var-wins pattern
# UPDATEWATCH2_DEMOMODE/UPDATEWATCH2_TRUSTEDIP above already use. Leave
# unset (or anything other than "false") to respect the admin-UI toggle,
# which defaults to enabled.
UPDATEWATCH2_AUTOUPDATE=

# Emergency recovery for a locked-out local admin account: set to a
# PasswordPolicy-valid value (>=16 chars, upper/lower/digit/symbol) to
# overwrite the admin account's password with it on the next startup,
# regardless of the current password. Safe to leave set across restarts
# — a content fingerprint of the value is stored, so the SAME value never
# re-applies (and never clobbers a password you've since changed via the
# UI); only setting it to a genuinely different value resets it again.
# Remove or change it once you've logged in. An invalid value is logged
# as an error and never applied.
UPDATEWATCH2_RESET_ADMIN_PASSWORD=
